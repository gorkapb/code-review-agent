# Copy this file to .env — Docker Compose reads it as the single source of config.
# Values use Docker Compose service hostnames, so they work as-is inside the stack.

# Application service connection strings (Docker Compose service hostnames).
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/code_review
REDIS_URL=redis://redis:6379

# PostgreSQL container bootstrap values.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=code_review

# Logging and service metadata.
SERVICE_NAME=code-review-agent
SERVICE_VERSION=0.1.0
ENV=development
LOG_LEVEL=INFO

# Optional GitHub API configuration.
# Leave the token blank for unauthenticated requests.
GITHUB_API_BASE_URL=
GITHUB_TOKEN=

# Anthropic API configuration for PR diff analysis.
ANTHROPIC_API_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Langfuse tracing configuration.
# Set keys from Langfuse project settings. Leave blank to run without tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Self-hosted Langfuse on the host is reached from containers via host.docker.internal.
LANGFUSE_BASE_URL=http://host.docker.internal:3000
LANGFUSE_TRACING_ENABLED=true
LANGFUSE_CAPTURE_CONTENT=false
LANGFUSE_DEBUG=false
LANGFUSE_SAMPLE_RATE=1.0

# OpenTelemetry trace and metric export configuration.
# Leave exporter endpoints blank to create spans without exporting them.
OTEL_ENABLED=true
OTEL_TRACES_ENABLED=true
OTEL_METRICS_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_TIMEOUT=10.0
OTEL_METRIC_EXPORT_INTERVAL_MILLIS=60000.0
OTEL_SAMPLE_RATE=1.0

# Eval judge configuration.
OPENAI_API_KEY=
EVAL_JUDGE_MODEL=gpt-4o-mini
