# Copy this file to .env for Docker Compose or local overrides.
# Without a .env file, local Python runs use the localhost defaults in src/config.py.

# Application service connection strings.
# Docker Compose uses service hostnames here. For host-local runs, use localhost.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/code_review
REDIS_URL=redis://redis:6379

# PostgreSQL container bootstrap values.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=code_review

# Logging and service metadata.
SERVICE_NAME=code-review-agent
SERVICE_VERSION=0.1.0
ENV=development
LOG_LEVEL=INFO

# Optional GitHub API configuration.
# Leave tokens blank for unauthenticated requests.
GITHUB_API_BASE_URL=
GITHUB_TOKEN=
GH_TOKEN=

# Anthropic API configuration for PR diff analysis.
ANTHROPIC_API_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
